# Development defaults for the GilJob v2 single-server Docker scaffold.
# Copy to .env and replace secrets before any non-local deployment.
# Default Realtime/MMM variables
PUBLIC_DOMAIN=:80
POSTGRES_DB=giljob
POSTGRES_USER=giljob
POSTGRES_PASSWORD=change-me-before-deploy
GILJOB_ENV=development
SESSION_TOKEN_TTL_SECONDS=7200
REPORT_TOKEN_TTL_SECONDS=2592000
SESSION_TOKEN_HASH_SECRET=change-me-session-token-hash-secret
REPORT_TOKEN_HASH_SECRET=change-me-report-token-hash-secret
# Default Realtime/MMM path does not require LiveKit; keep false unless running the optional media overlay.
LIVEKIT_REQUIRED=false
# API -> analysis-engine Realtime MMM handoff.
# Transcript and low-res vision samples travel only on the internal sideband; durable/public records stay redacted.
ANALYSIS_ENGINE_INTERNAL_URL=http://analysis-engine:8200
REALTIME_MMM_EVENT_LOG_PATH=/tmp/giljob-realtime-mmm-events.jsonl
REALTIME_MMM_FORWARD_ENABLED=true
REALTIME_MMM_FORWARD_TIMEOUT_SECONDS=2
MAX_REALTIME_EVENT_BYTES=8192
MAX_REALTIME_VISION_EVENT_BYTES=65536
MAX_REALTIME_VISION_FRAME_BYTES=49152

# Coach feedback LLM. Defaults to fake. Set provider to openai or gemini for live coach feedback.
OPENAI_API_BASE=https://api.openai.com/v1
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta
COACH_GEMINI_API_KEY=
COACH_LLM_PROVIDER=fake
# Optional: leave blank for provider default (openai: gpt-4.1-mini, gemini: gemini-2.5-flash).
COACH_LLM_MODEL=
COACH_LLM_TIMEOUT_SECONDS=15

# Primary interviewer voice path: OpenAI Realtime WebRTC broker. Keep real keys server-side only.
# services/api/server.py uses OPENAI_API_KEY server-side for Realtime session checks and SDP attach brokering.
OPENAI_API_KEY=replace-me-openai-server-key
OPENAI_REALTIME_API_BASE=https://api.openai.com/v1
OPENAI_REALTIME_PRIMARY=true
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
OPENAI_REALTIME_TRANSCRIPTION_LANGUAGE=ko
OPENAI_REALTIME_TRANSCRIPTION_DELAY=low
OPENAI_REALTIME_TIMEOUT_SECONDS=15
OPENAI_REALTIME_CALL_BROKER_ENABLED=true
OPENAI_REALTIME_SAFETY_SALT=giljob-realtime-v1

# Realtime live-smoke harness. Keep disabled until credentials/runtime are ready.
REALTIME_LIVE_SMOKE_ENABLED=false
REALTIME_SMOKE_BASE_URL=http://127.0.0.1/
REQUIRE_REALTIME_LIVE=0
GILJOB_WEB_URL=http://127.0.0.1/
GILJOB_API_URL=http://127.0.0.1/
GILJOB_REALTIME_SMOKE_INTERVIEW_ID=realtime-smoke

# Experimental API-owned avatar metadata flag. Default is disabled/deferred and does not prove lip-sync.
SPATIALREAL_BROWSER_AUDIO_BRIDGE_ENABLED=false
SPATIALREAL_SDK_MODE_WEB_ENABLED=false
SPATIALREAL_SDK_MODE_OUTCOME=sdk_mode_deferred

# Optional Cloudflare Tunnel placeholders for legacy/avatar RTC LiveKit signaling only.
# Not required for default OpenAI Realtime + MMM.
# Keep real account IDs, API tokens, tunnel IDs, and tunnel secrets in .env only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_NAME=giljob-v2-livekit
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_SECRET=
CLOUDFLARE_ZONE_ID=
LIVEKIT_TUNNEL_HOSTNAME=livekit.example.com

# Optional legacy/avatar RTC self-hosted LiveKit addressing.
# LIVEKIT_INTERNAL_URL is for API/container calls; LIVEKIT_PUBLIC_URL is returned to browsers when the media overlay is enabled.
# hashimoto strategy engine (internal sidecar). Provide its Gemini credential out-of-band when enabling it.
HASHIMOTO_ANALYSIS_MODEL=gemini-3.1-flash-lite
HASHIMOTO_BASE_URL=http://hashimoto:8200

# LIVEKIT_URL remains a legacy single-URL fallback for old scaffold runs.
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# GilJobE analysis-engine integration.
GILJOBE_GIT_URL=https://github.com/GilJob-E/GilJobE.git
GILJOBE_GIT_REF=f7307fc
VLLM_BASE_URL=http://giljob-v2-gemma-e4b:8000
# Legacy no-op for ordinary OpenAI Realtime. RNAS uses API sideband events and exact-turn
# /realtime/turn-results; /analysis/subscriber/start is legacy/non-main-path only.
ANALYSIS_ENGINE_ENABLE_SUBSCRIBER=false
# Objective grounding lanes (GilJobE: vision MediaPipe + audio prosody, inject-and-emit).
# auto = enable when deps/models are present (the image bakes both); off = explicit disable.
GILJOBE_VISION=auto
GILJOBE_PROSODY=auto
# external = primary Realtime-native RNAS ingestion: answer sideband -> analysis-engine MMM/RNAS
# -> API response.create -> OpenAI Realtime output. Set internal only for legacy LiveKit/Gemma STT grid testing.
GILJOBE_TRANSCRIPT_SOURCE=external
# Deployment defaults (2026-06-12): eval off (content judged by next-question LLM),
# 3fps JPEG buffer + nv frame cap 24 (denser nv reads, covers sub-second sentences
# the 1fps library default starves). Validated in qa/runs/2026-06-12-nv3fps-evaloff.
GILJOBE_EVAL_GRID=off
GILJOBE_FRAME_FPS=3
GILJOBE_NV_FRAME_CAP=24
LIVEKIT_SESSION_ID=local-demo
LIVEKIT_IDENTITY=giljobe-analysis
# Optional pre-issued hidden analyzer token. Prefer API-issued analyzer tokens in production; do not commit real values.
LIVEKIT_ANALYZER_TOKEN=

# Optional legacy LiveKit/AvatarKit RTC variables
# Optional media overlay for legacy/browser LiveKit tests and avatar RTC only.
# Not required for default OpenAI Realtime + MMM smoke.
# docker compose -f infra/docker-compose.yml -f infra/docker-compose.media.yml ...
LIVEKIT_MEDIA_OVERLAY_ENABLED=false
LIVEKIT_API_KEY=replace-me-local-only
LIVEKIT_API_SECRET=replace-me-local-only-minimum-32-bytes
TURN_REALM=turn.example.com
TURN_STATIC_AUTH_SECRET=replace-me-local-only-minimum-32-bytes
