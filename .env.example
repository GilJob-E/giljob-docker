# Development defaults for the GilJob v2 single-server Docker scaffold.
# Copy to .env and replace secrets before any non-local deployment.
PUBLIC_DOMAIN=:80
POSTGRES_DB=giljob
POSTGRES_USER=giljob
POSTGRES_PASSWORD=change-me-before-deploy
GILJOB_ENV=development
SESSION_TOKEN_TTL_SECONDS=7200
REPORT_TOKEN_TTL_SECONDS=2592000
SESSION_TOKEN_HASH_SECRET=change-me-session-token-hash-secret
REPORT_TOKEN_HASH_SECRET=change-me-report-token-hash-secret
LIVEKIT_REQUIRED=false

# Main LLM provider for the interview controller / ai-engine.
# Gemini quickstart expects the API key in GEMINI_API_KEY.
# Get a key from Google AI Studio and paste it into your local .env only.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30


# Local self-hosted LiveKit addressing.
# LIVEKIT_INTERNAL_URL is for API/container calls; LIVEKIT_PUBLIC_URL is returned to browsers.
# LIVEKIT_URL remains a legacy single-URL fallback for old scaffold runs.
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# Optional media overlay: docker compose -f infra/docker-compose.yml -f infra/docker-compose.media.yml ...
LIVEKIT_API_KEY=replace-me-local-only
LIVEKIT_API_SECRET=replace-me-local-only-minimum-32-bytes
LIVEKIT_DOMAIN=livekit.example.com
TURN_DOMAIN=turn.example.com
TURN_REALM=turn.example.com
TURN_STATIC_AUTH_SECRET=replace-me-local-only-minimum-32-bytes
