# Development defaults for the GilJob v2 single-server Docker scaffold.
# Copy to .env and replace secrets before any non-local deployment.
PUBLIC_DOMAIN=:80
POSTGRES_DB=giljob
POSTGRES_USER=giljob
POSTGRES_PASSWORD=change-me-before-deploy
GILJOB_ENV=development
SESSION_TOKEN_TTL_SECONDS=7200
REPORT_TOKEN_TTL_SECONDS=2592000
SESSION_TOKEN_HASH_SECRET=change-me-session-token-hash-secret
REPORT_TOKEN_HASH_SECRET=change-me-report-token-hash-secret
LIVEKIT_REQUIRED=false
AI_ENGINE_INTERNAL_URL=http://ai-engine:8100

# Main LLM provider for the interview controller / ai-engine.
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-me-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30

# Interviewer voice / TTS provider. Keep real keys server-side only.
# Use VOICE_PROVIDER=fake for keyless local smoke; use gemini for Gemini native TTS; elevenlabs remains supported.
VOICE_PROVIDER=fake
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Kore
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_OUTPUT_FORMAT=mp3_22050_32
TTS_PROVIDER_FAILURE_FALLBACK=

# SpatialReal avatar session broker. Endpoints normally derive from SPATIALREAL_REGION.
AVATAR_PROVIDER=disabled
SPATIALREAL_API_KEY=
SPATIALREAL_APP_ID=
SPATIALREAL_AVATAR_ID=
SPATIALREAL_REGION=ap-northeast
SPATIALREAL_SESSION_TTL_SECONDS=900
AVATAR_PROVIDER_FAILURE_FALLBACK=
SPATIALREAL_AUDIO_SAMPLE_RATE=16000
SPATIALREAL_AUDIO_CHANNEL_COUNT=1
# RTC/LiveKit avatar egress. Requires a LiveKit URL reachable by SpatialReal.
SPATIALREAL_RTC_EGRESS_ENABLED=false
SPATIALREAL_RTC_LIVEKIT_URL=
SPATIALREAL_RTC_PUBLISHER_ID_PREFIX=spatialreal-avatar
SPATIALREAL_RTC_IDLE_TIMEOUT_SECONDS=30
SPATIALREAL_RTC_SETTLE_SECONDS=1.0

# Optional Cloudflare Tunnel placeholders for making self-hosted LiveKit signaling reachable.
# Keep real account IDs, API tokens, tunnel IDs, and tunnel secrets in .env only.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_TUNNEL_NAME=giljob-v2-livekit
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_SECRET=
CLOUDFLARE_ZONE_ID=
LIVEKIT_TUNNEL_HOSTNAME=livekit.example.com

# hashimoto strategy engine (internal sidecar) -- reuses GEMINI_API_KEY above.
HASHIMOTO_ANALYSIS_MODEL=gemini-3.1-flash-lite
# Internal URL the ai-engine pulls hashimoto strategy from. Non-blocking, best-effort:
# if hashimoto is cold or down, ai-engine degrades gracefully to transcript-only.
# Leave empty to disable consumption.
HASHIMOTO_BASE_URL=http://hashimoto:8200

# Local self-hosted LiveKit addressing.
# LIVEKIT_INTERNAL_URL is for API/container calls; LIVEKIT_PUBLIC_URL is returned to browsers.
# LIVEKIT_URL remains a legacy single-URL fallback for old scaffold runs.
LIVEKIT_INTERNAL_URL=ws://livekit:7880
LIVEKIT_PUBLIC_URL=ws://127.0.0.1:7880
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=
LIVEKIT_TOKEN_TTL_SECONDS=7200

# GilJobE analysis-engine integration.
GILJOBE_GIT_URL=https://github.com/GilJob-E/GilJobE.git
GILJOBE_GIT_REF=b769120
VLLM_BASE_URL=http://giljob-v2-gemma-e4b:8000
ANALYSIS_ENGINE_ENABLE_SUBSCRIBER=false
LIVEKIT_SESSION_ID=local-demo
LIVEKIT_IDENTITY=giljobe-analysis
# Optional pre-issued hidden analyzer token. Prefer API-issued analyzer tokens in production; do not commit real values.
LIVEKIT_ANALYZER_TOKEN=

# Optional media overlay: docker compose -f infra/docker-compose.yml -f infra/docker-compose.media.yml ...
LIVEKIT_API_KEY=replace-me-local-only
LIVEKIT_API_SECRET=replace-me-local-only-minimum-32-bytes
TURN_REALM=turn.example.com
TURN_STATIC_AUTH_SECRET=replace-me-local-only-minimum-32-bytes
